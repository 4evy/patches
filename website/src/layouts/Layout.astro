---
import '../styles/global.css';
import { siGithub } from 'simple-icons';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '4evy patches',
  description = 'A personal catalog of small, reusable patch stacks.',
} = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f8f1f2" />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let savedTheme;
        try {
          savedTheme = localStorage.getItem('patches-theme');
        } catch {}
        const isDark =
          savedTheme === 'dark' ||
          (savedTheme !== 'light' &&
            matchMedia('(prefers-color-scheme: dark)').matches);
        root.classList.toggle('dark', isDark);
        root.classList.toggle('light', !isDark);
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute('content', isDark ? '#100d14' : '#f8f1f2');
      })();
    </script>
    <link
      rel="icon"
      href="https://avatars.githubusercontent.com/u/57304299?s=64&v=4"
      type="image/png"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="site-nav page-shell">
        <nav class="site-links" aria-label="Primary navigation">
          <a
            class="wordmark"
            href={base}
            aria-label="4evy patches, home"
          >
            <span class="wordmark-owner">4evy</span>
            <span class="wordmark-divider" aria-hidden="true"></span>
            <span>patches</span>
          </a>
          <ul>
            <li>
              <a
                href="https://github.com/4evy/patches"
                aria-label="4evy patches repository on GitHub"
              >
                <svg
                  class="brand-icon"
                  aria-hidden="true"
                  viewBox="0 0 24 24"
                >
                  <path d={siGithub.path}></path>
                </svg>
              </a>
            </li>
          </ul>
        </nav>
        <button class="theme-toggle" type="button">
          <svg
            class="theme-icon theme-icon-moon"
            aria-hidden="true"
            viewBox="0 0 24 24"
          >
            <path
              d="M20.4 14.1A8.5 8.5 0 0 1 9.9 3.6 8.5 8.5 0 1 0 20.4 14.1Z"
            ></path>
          </svg>
          <span class="visually-hidden theme-toggle-label"
            >Use dark color theme</span
          >
        </button>
      </div>
    </header>

    <div class="site-body">
      <slot />
    </div>

    <script>
      const root = document.documentElement;
      const toggle =
        document.querySelector<HTMLButtonElement>('.theme-toggle');
      const label = document.querySelector<HTMLElement>(
        '.theme-toggle-label',
      );
      const themeColor = document.querySelector<HTMLMetaElement>(
        'meta[name="theme-color"]',
      );

      function updateThemeControl() {
        const isDark = root.classList.contains('dark');
        if (label)
          label.textContent = isDark
            ? 'Use light color theme'
            : 'Use dark color theme';
        themeColor?.setAttribute(
          'content',
          isDark ? '#100d14' : '#f8f1f2',
        );
      }

      updateThemeControl();
      toggle?.addEventListener('click', () => {
        const isDark = root.classList.contains('dark');
        root.classList.toggle('dark', !isDark);
        root.classList.toggle('light', isDark);
        try {
          localStorage.setItem(
            'patches-theme',
            isDark ? 'light' : 'dark',
          );
        } catch {}
        updateThemeControl();
      });
    </script>
  </body>
</html>
