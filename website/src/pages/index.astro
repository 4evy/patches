---
import Layout from '../layouts/Layout.astro';
import GlassButton from '../components/GlassButton.astro';
import { ExternalLink } from '@lucide/astro';
import { loadCatalog } from '../lib/catalog.ts';

const base = import.meta.env.BASE_URL;
const catalog = await loadCatalog();

function repositoryName(canonical: string) {
  try {
    return new URL(canonical).pathname
      .replace(/^\//, '')
      .replace(/\.git$/, '');
  } catch {
    return canonical;
  }
}

function revisionUrl(canonical: string, revision: string) {
  return `${canonical.replace(/\.git$/, '')}/commit/${revision}`;
}
---

<Layout>
  <main id="main-content" class="home-page page-shell">
    <section class="hero" aria-labelledby="page-title">
      <header>
        <p class="eyebrow">4evy / patches</p>
        <h1 id="page-title">My patches</h1>
        <p class="lede">
          My personal patches for open-source software I use
        </p>
        <p class="hero-actions">
          <GlassButton
            href="https://github.com/4evy/patches"
            variant="quiet"
          >
            View on GitHub <ExternalLink aria-hidden="true" size={15} />
          </GlassButton>
        </p>
      </header>
    </section>

    {
      catalog.stacks.length === 0 ? (
        <section class="empty-state" aria-labelledby="empty-title">
          <p class="eyebrow">Stacks · 0</p>
          <h2 id="empty-title">The garden is quiet.</h2>
          <p>
            There are no published patch stacks yet. Add one under{' '}
            <code>stacks/</code> and the catalog will update
            immediately.
          </p>
        </section>
      ) : (
        <section
          class="stack-index"
          id="stacks"
          aria-labelledby="stacks-title"
        >
          <header class="section-heading">
            <h2 id="stacks-title">Patch stacks</h2>
          </header>

          <div class="stack-table">
            <ol class="stack-list">
              {catalog.stacks.map((stack) => (
                <li>
                  <article class="stack-card">
                    <div class="card-main">
                      <header>
                        <p class="card-kicker">
                          {repositoryName(
                            stack.manifest.source.canonical,
                          )}
                        </p>
                        <h3>
                          <a href={`${base}stacks/${stack.id}/`}>
                            {stack.id}
                          </a>
                        </h3>
                      </header>
                    </div>
                    <dl class="card-meta">
                      <div>
                        <dt>Patches</dt>
                        <dd>{stack.patches.length}</dd>
                      </div>
                      <div>
                        <dt>Revision</dt>
                        <dd>
                          <a
                            class="revision-link"
                            href={revisionUrl(
                              stack.manifest.source.canonical,
                              stack.manifest.source.revision,
                            )}
                          >
                            <code>
                              {stack.manifest.source.revision.slice(
                                0,
                                9,
                              )}
                            </code>
                            <ExternalLink
                              aria-hidden="true"
                              size={13}
                            />
                            <span class="visually-hidden">
                              View upstream commit
                            </span>
                          </a>
                        </dd>
                      </div>
                    </dl>
                    <a
                      class="card-action"
                      href={`${base}stacks/${stack.id}/`}
                    >
                      Open stack
                    </a>
                  </article>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }
  </main>
</Layout>
