+fn add_commit_to_ref(
+    git_repo: &gix::Repository,
+    ref_name: &str,
+    file_name: &str,
+    message: &str,
+) -> gix::ObjectId {
+    let parents = git_repo
+        .find_reference(ref_name)
+        .ok()
+        .and_then(|mut r| r.peel_to_commit().ok())
+        .map(|c| vec![c.id().detach()])
+        .unwrap_or_default();
+
+    git::add_commit(
+        git_repo,
+        ref_name,
+        file_name,
+        file_name.as_bytes(),
+        message,
+        &parents,
+    )
+    .commit_id
+}
