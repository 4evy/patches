+/// Error occurred while parsing a date-time expression.
+#[derive(Debug, Error)]
+#[error("Couldn't understand `{input}` as a date and time")]
+pub struct DateTimeExpressionParseError {
+    input: String,
+    #[source]
+    source: Box<dyn std::error::Error + Send + Sync>,
+}
