+    [EOF]
+    "
+    );
+    work_dir
+        .run_jj(["git", "ref", "forget", "--remote=origin", "pull/123/head"])
+        .success();
+    work_dir
+        .run_jj([
+            "git",
+            "ref",
+            "forget",
+            "--remote=origin",
