+        work_dir.run_jj(["git", "ref", "fetch", &"0".repeat(64)]),
+        @r"
+    ------- stderr -------
+    Error: Git object ID uses sha256, but this repository uses sha1
+    [EOF]
+    [exit status: 1]
+    "
+    );
+}
