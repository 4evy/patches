Subject: git push: preserve redated metadata while signing


diff --git a/CHANGELOG.md b/CHANGELOG.md
index 491f108cb1485d79a9d2e40bb1ba71af14b3c3c2..b1962d3b11901ff74da6d7c6edc41e9dbc8cdee5 100644
--- a/CHANGELOG.md
+++ b/CHANGELOG.md
@@ -64,6 +64,10 @@ to [Semantic Versioning](https://semver.org/spec/v2.0.0.html).
   when the commit stack is taller than the terminal.
   [#9033](https://github.com/jj-vcs/jj/issues/9033).
 
+* Signing commits during `jj git push` now preserves their author and committer
+  metadata, including timestamps set by `jj redate`. Metadata is also preserved
+  on descendants rebased by the signing rewrite.
+
 * `jj git push` now warns when `git.sign-on-push` selects immutable commits
   instead of silently leaving them unsigned.
 
diff --git a/cli/src/commands/git/push.rs b/cli/src/commands/git/push.rs
index b9f9424d5ef8ea1a2da8682739ff8c6d37cb4bd3..a8918c5798089a3f4f8218dcf8beec52ac4bf73c 100644
--- a/cli/src/commands/git/push.rs
+++ b/cli/src/commands/git/push.rs
@@ -872,23 +872,30 @@ async fn sign_commits_before_push(
                 async |rewriter: CommitRewriter<'_>| {
                     let old_commit = rewriter.old_commit();
                     let old_commit_id = old_commit.id().clone();
+                    let old_author = old_commit.author().clone();
+                    let old_committer = old_commit.committer().clone();
                     if let Some(writer) = &mut progress_writer {
                         writer
                             .display(&short_change_hash(old_commit.change_id()))
                             .ok();
                     }
-                    if commit_ids.contains(&old_commit_id) {
-                        let commit = rewriter
-                            .reparent()
-                            .set_sign_behavior(SignBehavior::Force)
-                            .write()
-                            .await?;
-                        old_to_new_commits_map.insert(old_commit_id, commit.id().clone());
+                    let sign_behavior = if commit_ids.contains(&old_commit_id) {
+                        SignBehavior::Force
                     } else {
                         num_rebased_descendants += 1;
-                        let commit = rewriter.reparent().write().await?;
-                        old_to_new_commits_map.insert(old_commit_id, commit.id().clone());
-                    }
+                        SignBehavior::Keep
+                    };
+                    // Signing is a transport concern. Preserve the metadata the user
+                    // authored (including dates set by `jj redate`) for both signed
+                    // commits and descendants rewritten because their parent changed.
+                    let commit = rewriter
+                        .reparent()
+                        .set_author(old_author)
+                        .set_committer(old_committer)
+                        .set_sign_behavior(sign_behavior)
+                        .write()
+                        .await?;
+                    old_to_new_commits_map.insert(old_commit_id, commit.id().clone());
                     Ok(())
                 },
             )
