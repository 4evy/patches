+        gix::refs::transaction::PreviousValue::Any,
+        "create blob ref",
+    )?;
+
+    let output = work_dir.run_jj([
+        "git",
+        "ref",
+        "fetch",
+        "--remote",
+        "origin",
+        "refs/pull/123/head",
