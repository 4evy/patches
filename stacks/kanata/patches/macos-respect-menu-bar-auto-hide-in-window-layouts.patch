+#[repr(C)]
+#[derive(Clone, Copy)]
+struct NSEdgeInsets {
+    top: f64,
+    left: f64,
+    bottom: f64,
+    right: f64,
+}
+
+unsafe impl Encode for NSEdgeInsets {
+    fn encode() -> Encoding {
+        // AppKit uses four CGFloat fields, which are doubles on 64-bit macOS.
+        unsafe { Encoding::from_str("{NSEdgeInsets=dddd}") }
+    }
+}
+
+type MainConnectionId = unsafe extern "C" fn() -> i32;
+type GetMenuBarAutohideEnabled = unsafe extern "C" fn(i32, *mut u8) -> i32;
+
+fn menu_bar_autohides() -> bool {
+    static API: OnceLock<Option<(MainConnectionId, GetMenuBarAutohideEnabled)>> = OnceLock::new();
+    let Some(&(connection, autohide)) = API
+        .get_or_init(|| unsafe {
+            // CoreGraphics re-exports these SkyLight entry points. Resolve them optionally so an
+            // unavailable private API leaves the public NSScreen geometry intact.
+            let connection = libc::dlsym(libc::RTLD_DEFAULT, c"CGSMainConnectionID".as_ptr());
+            let autohide =
+                libc::dlsym(libc::RTLD_DEFAULT, c"CGSGetMenuBarAutohideEnabled".as_ptr());
+            if connection.is_null() || autohide.is_null() {
+                log::debug!("macos-window menu-bar state API unavailable; using NSScreen bounds");
+                return None;
+            }
+            Some((
+                std::mem::transmute::<*mut c_void, MainConnectionId>(connection),
+                std::mem::transmute::<*mut c_void, GetMenuBarAutohideEnabled>(autohide),
+            ))
+        })
+        .as_ref()
+    else {
+        return false;
+    };
+    // The output is a one-byte Boolean, verified against SkyLight on macOS 26.6.2.
+    // Query on every action: the user's setting can change while the worker is running.
+    let mut enabled = 0u8;
+    let error = unsafe { autohide(connection(), &mut enabled) };
+    if error != 0 {
+        log::debug!("macos-window menu-bar state query failed: {error}");
+    }
+    error == 0 && enabled != 0
+}
+
