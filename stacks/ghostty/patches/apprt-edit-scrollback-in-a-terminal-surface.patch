+    /// Replace a surface without changing its position in the split tree
+    pub fn replaceSurface(
+        self: *Self,
+        old: *Surface,
+        new: *Surface,
+    ) Allocator.Error!bool {
+        const old_tree = self.getTree() orelse return false;
+        const handle = old_tree.locate(old) orelse return false;
+
+        var new_tree = try old_tree.replace(
+            Application.default().allocator(),
+            handle,
+            new,
+        );
+        defer new_tree.deinit();
+
+        const last_focused = self.private().last_focused.get();
+        defer if (last_focused) |surface| surface.unref();
+        if (last_focused == old) self.private().last_focused.set(new);
+        self.setTree(&new_tree);
+        new.bindIsSplit(self);
+        return true;
+    }
