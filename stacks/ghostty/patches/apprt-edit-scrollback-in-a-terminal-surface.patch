+            guard target.tag == GHOSTTY_TARGET_SURFACE,
+                  let coreSurface = target.target.surface,
+                  let original = surfaceView(from: coreSurface),
+                  let controller = BaseTerminalController.controller(owning: original),
+                  let node = controller.surfaceTree.root?.node(view: original),
+                  let directoryPointer = value.directory,
+                  let commandPointer = value.command
+            else { return false }
+
+            let directoryData = Data(bytes: directoryPointer, count: Int(value.directory_len))
+            guard let directory = String(data: directoryData, encoding: .utf8) else { return false }
