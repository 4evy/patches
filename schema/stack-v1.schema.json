{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/4evy/patches/master/schema/stack-v1.schema.json",
  "title": "4evy Patch Stack Manifest",
  "description": "The cross-tool metadata for a Git-backed Quilt patch stack.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "manifestVersion", "id", "source"],
  "properties": {
    "$schema": {
      "const": "https://raw.githubusercontent.com/4evy/patches/master/schema/stack-v1.schema.json"
    },
    "manifestVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "result": {
      "$ref": "#/$defs/result"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vcs", "canonical", "revision", "endpoints"],
      "properties": {
        "vcs": {
          "const": "git"
        },
        "canonical": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
        },
        "trackingRef": {
          "type": "string",
          "pattern": "^refs/"
        },
        "endpoints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/endpoint"
          }
        },
        "checkout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "submodules": {
              "enum": [false, "recursive"]
            },
            "lfs": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "role", "priority"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "role": {
          "enum": ["primary", "mirror"]
        },
        "priority": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree"],
      "properties": {
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "oid"],
          "properties": {
            "algorithm": {
              "enum": ["sha1", "sha256"]
            },
            "oid": {
              "type": "string",
              "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
            }
          }
        }
      }
    }
  }
}
